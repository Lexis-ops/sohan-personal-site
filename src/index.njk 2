<!-- ============ WRITING (CMS-driven) ============ -->
<section class="section" id="writing">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="eyebrow">The Writer's Notebook</div>
      <h2>Featured Writing</h2>
      <p>Essays on leadership, technology, identity, and society — published straight from the admin panel.</p>
    </div>

    {% if collections.essays.length %}
    <div class="essays reveal">
      {% for essay in collections.essays | limit(4) %}
      <a href="{{ essay.url }}" class="essay" style="display:block;">
        <div class="cat">{{ essay.data.category }}</div>
        <h3>{{ essay.data.title }}</h3>
        <p>{{ essay.data.excerpt }}</p>
        <span class="read">Read the essay <span class="arrow">→</span></span>
      </a>
      {% endfor %}
    </div>
    {% else %}
    <p class="empty-note">No essays published yet — add one from the admin panel at /admin.</p>
    {% endif %}

    <div class="essays-more reveal">
      <a href="#" class="btn btn-outline">Read More Essays</a>
    </div>
  </div>
</section>

<!-- ============ RESOURCES / DOCUMENTS (CMS-driven) ============ -->
<section class="section section-dim" id="resources">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="eyebrow">Resources</div>
      <h2>Documents &amp; Downloads</h2>
      <p>Guides, toolkits, and documents I've shared — uploaded and managed from the admin panel.</p>
    </div>

    {% if collections.documents.length %}
    <div class="resources-grid reveal">
      {% for doc in collections.documents %}
      <div class="resource-card">
        <div class="rc-date">{{ doc.data.date | dateShort }}</div>
        <h3>{{ doc.data.title }}</h3>
        <p>{{ doc.data.description }}</p>
        <a class="dl" href="{{ doc.data.file }}" download>Download <span>→</span></a>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <p class="empty-note">No documents uploaded yet — add one from the admin panel at /admin.</p>
    {% endif %}
  </div>
</section>

