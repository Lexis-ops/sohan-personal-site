  :root{
    --navy:#0F172A;
    --navy-soft:#16213B;
    --teal:#0EA5A4;
    --teal-deep:#0B7F7E;
    --gold:#D4A017;
    --gold-soft:#E7C463;
    --ivory:#FAF9F6;
    --ivory-dim:#F1EEE7;
    --ink:#232A36;
    --ink-soft:#5B6472;
    --line:#E4E0D6;
    --serif: 'Playfair Display', Georgia, serif;
    --sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    --maxw: 1180px;
  }

  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:var(--sans);
    background:var(--ivory);
    color:var(--ink);
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  img{max-width:100%; display:block;}
  a{color:inherit; text-decoration:none;}
  ul{list-style:none;}
  .wrap{max-width:var(--maxw); margin:0 auto; padding:0 32px;}
  section{position:relative;}
  .eyebrow{
    font-family:var(--sans);
    font-size:12.5px;
    letter-spacing:0.22em;
    text-transform:uppercase;
    color:var(--teal-deep);
    font-weight:600;
    display:inline-flex;
    align-items:center;
    gap:10px;
    margin-bottom:18px;
  }
  .eyebrow::before{
    content:"";
    width:22px; height:1px;
    background:var(--gold);
    display:inline-block;
  }
  h1,h2,h3,h4{font-family:var(--serif); font-weight:600; color:var(--navy); line-height:1.18;}
  .btn{
    display:inline-flex; align-items:center; gap:10px;
    padding:15px 30px;
    border-radius:2px;
    font-family:var(--sans);
    font-size:14.5px;
    font-weight:600;
    letter-spacing:0.02em;
    cursor:pointer;
    border:1px solid transparent;
    transition: all .35s cubic-bezier(.2,.8,.2,1);
  }
  .btn-primary{ background:var(--navy); color:var(--ivory); }
  .btn-primary:hover{ background:var(--teal-deep); transform:translateY(-2px); box-shadow:0 10px 24px -8px rgba(14,165,164,0.45); }
  .btn-outline{ border-color: rgba(15,23,42,0.25); color:var(--navy); background:transparent; }
  .btn-outline:hover{ border-color:var(--gold); color:var(--navy); background:rgba(212,160,23,0.08); transform:translateY(-2px); }
  .btn-ghost-light{ border-color:rgba(250,249,246,0.35); color:var(--ivory); }
  .btn-ghost-light:hover{ border-color:var(--gold-soft); background:rgba(212,160,23,0.12); transform:translateY(-2px); }

  /* ---------- reveal on scroll ---------- */
  .reveal{ opacity:0; transform:translateY(22px); transition:opacity .9s cubic-bezier(.2,.7,.2,1), transform .9s cubic-bezier(.2,.7,.2,1); }
  .reveal.in{ opacity:1; transform:translateY(0); }
  .reveal-delay-1{ transition-delay:.12s; }
  .reveal-delay-2{ transition-delay:.24s; }
  .reveal-delay-3{ transition-delay:.36s; }

  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    .reveal{opacity:1; transform:none; transition:none;}
    *{animation:none !important; transition:none !important;}
  }

  /* ---------- nav ---------- */
  header{
    position:fixed; top:0; left:0; right:0; z-index:100;
    background:rgba(250,249,246,0.82);
    backdrop-filter: blur(10px);
    border-bottom:1px solid rgba(15,23,42,0.06);
    transition: background .3s ease;
  }
  .nav{
    max-width:var(--maxw); margin:0 auto; padding:18px 32px;
    display:flex; align-items:center; justify-content:space-between;
  }
  .brand{
    font-family:var(--serif); font-weight:700; font-size:19px; color:var(--navy);
    letter-spacing:0.01em;
  }
  .brand span{color:var(--teal-deep);}
  .nav-links{ display:flex; gap:34px; align-items:center; }
  .nav-links a{
    font-size:13.5px; font-weight:600; letter-spacing:0.03em; text-transform:uppercase;
    color:var(--ink-soft);
    position:relative; padding-bottom:4px;
  }
  .nav-links a::after{
    content:""; position:absolute; left:0; bottom:0; width:0; height:1.5px;
    background:var(--gold); transition:width .3s ease;
  }
  .nav-links a:hover{color:var(--navy);}
  .nav-links a:hover::after{width:100%;}
  .nav-cta{
    padding:10px 20px; font-size:13px;
  }
  .burger{ display:none; flex-direction:column; gap:5px; cursor:pointer; background:none; border:none; }
  .burger span{ width:24px; height:2px; background:var(--navy); display:block; }
  .mobile-menu{
    display:none; flex-direction:column; gap:0; background:var(--ivory);
    border-top:1px solid var(--line); position:fixed; top:64px; left:0; right:0; z-index:99;
    padding:10px 32px 26px;
  }
  .mobile-menu a{ padding:14px 0; border-bottom:1px solid var(--line); font-weight:600; font-size:14px; color:var(--navy); }
  .mobile-menu.open{ display:flex; }

  @media (max-width:880px){
    .nav-links{display:none;}
    .burger{display:flex;}
  }

  /* ---------- hero ---------- */
  .hero{
    min-height:100vh;
    display:flex; align-items:center;
    padding:150px 0 90px;
    background:
      radial-gradient(1100px 620px at 82% -10%, rgba(14,165,164,0.10), transparent 60%),
      radial-gradient(700px 500px at 8% 110%, rgba(212,160,23,0.10), transparent 60%),
      var(--ivory);
    position:relative;
    overflow:hidden;
  }
  .hero-grid{
    display:grid; grid-template-columns: 1.05fr 0.95fr; gap:70px; align-items:center;
  }
  .hero-eyebrow{ color:var(--teal-deep); }
  .hero h1{
    font-size:clamp(40px, 5.2vw, 66px);
    letter-spacing:-0.01em;
    margin-bottom:26px;
  }
  .hero h1 em{ font-style:italic; color:var(--teal-deep); }
  .hero p.lede{
    font-size:18px; color:var(--ink-soft); max-width:520px; margin-bottom:38px; line-height:1.75;
  }
  .hero-actions{ display:flex; gap:16px; flex-wrap:wrap; }

  .hero-art{ position:relative; }
  .manuscript{ width:100%; height:auto; }
  .hero-caption{
    margin-top:18px; font-size:12.5px; color:var(--ink-soft); text-align:center;
    letter-spacing:0.05em; text-transform:uppercase; opacity:.7;
  }

  @media (max-width:960px){
    .hero-grid{grid-template-columns:1fr; gap:50px;}
    .hero{padding-top:120px;}
    .hero-art{order:-1; max-width:420px; margin:0 auto;}
  }

  /* ---------- section shells ---------- */
  .section{ padding:130px 0; }
  .section-tight{ padding:110px 0; }
  .section-dark{ background:var(--navy); color:var(--ivory); }
  .section-dark h2, .section-dark h3{ color:var(--ivory); }
  .section-dim{ background:var(--ivory-dim); }
  .section-head{ max-width:640px; margin-bottom:64px; }
  .section-head h2{ font-size:clamp(30px,3.6vw,44px); }
  .section-head p{ color:var(--ink-soft); font-size:17px; margin-top:16px; max-width:560px; }
  .section-dark .section-head p{ color:#B9C3D4; }

  .divider-mark{
    width:46px; height:46px; margin:0 auto 26px;
    opacity:.85;
  }

  /* ---------- story ---------- */
  .story-grid{ display:grid; grid-template-columns: 0.85fr 1.15fr; gap:80px; align-items:start; }
  .story-quote{
    font-family:var(--serif); font-style:italic; font-size:24px; color:var(--navy);
    line-height:1.5; border-left:2px solid var(--gold); padding-left:26px; margin-bottom:26px;
  }
  .story-copy p{ color:var(--ink-soft); font-size:16.5px; margin-bottom:20px; }
  .story-copy strong{ color:var(--navy); font-weight:600; }
  .timeline{ margin-top:12px; }
  .timeline li{
    display:grid; grid-template-columns: 92px 1fr; gap:20px;
    padding:18px 0; border-top:1px solid var(--line);
  }
  .timeline li:last-child{ border-bottom:1px solid var(--line); }
  .timeline .yr{ font-family:var(--serif); color:var(--gold); font-weight:600; font-size:15px; padding-top:2px;}
  .timeline .tt{ font-weight:600; color:var(--navy); font-size:15px; }
  .timeline .td{ color:var(--ink-soft); font-size:14.5px; margin-top:3px; }

  @media (max-width:900px){ .story-grid{grid-template-columns:1fr; gap:40px;} }

  /* ---------- beliefs ---------- */
  .beliefs-grid{
    display:grid; grid-template-columns:repeat(3,1fr); gap:26px;
  }
  .belief-card{
    background:var(--ivory); border:1px solid var(--line); padding:38px 30px;
    transition: transform .4s cubic-bezier(.2,.8,.2,1), box-shadow .4s ease, border-color .4s ease;
    position:relative;
  }
  .belief-card:hover{ transform:translateY(-6px); box-shadow:0 24px 44px -20px rgba(15,23,42,0.18); border-color:transparent; }
  .belief-num{
    font-family:var(--serif); font-style:italic; color:var(--gold); font-size:15px; margin-bottom:20px; display:block;
  }
  .belief-card h4{ font-size:19px; margin-bottom:12px; }
  .belief-card p{ color:var(--ink-soft); font-size:14.5px; }
  .belief-card.wide{ grid-column: span 1; }
  @media (max-width:900px){ .beliefs-grid{grid-template-columns:1fr 1fr;} }
  @media (max-width:600px){ .beliefs-grid{grid-template-columns:1fr;} }

  /* ---------- AI for professionals ---------- */
  .ai-top{ display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center; margin-bottom:80px; }
  .ai-top p{ color:#B9C3D4; font-size:16.5px; margin-top:16px; }
  @media (max-width:900px){ .ai-top{grid-template-columns:1fr;} }

  .agents{ display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
  .card-drawer{
    background:var(--navy-soft);
    border:1px solid rgba(250,249,246,0.12);
    padding:0;
    overflow:hidden;
    transition: transform .4s ease, border-color .4s ease;
  }
  .card-drawer:hover{ transform:translateY(-6px); border-color:rgba(212,160,23,0.5); }
  .card-drawer .plate{
    padding:30px 28px 22px;
    border-bottom:1px dashed rgba(250,249,246,0.18);
  }
  .card-drawer .tag{
    font-size:11px; letter-spacing:.18em; text-transform:uppercase; color:var(--gold-soft); font-weight:700;
  }
  .card-drawer h4{ color:var(--ivory); font-size:24px; margin-top:10px; }
  .card-drawer .role{ color:var(--teal); font-size:13.5px; font-weight:600; margin-top:4px;}
  .card-drawer .body{ padding:24px 28px 30px; color:#AEB9CB; font-size:14.5px; }
  .card-drawer .body ul{ margin-top:14px; }
  .card-drawer .body li{ padding:6px 0; font-size:13.8px; color:#9FACC0; position:relative; padding-left:18px; }
  .card-drawer .body li::before{ content:"—"; position:absolute; left:0; color:var(--teal); }
  @media (max-width:900px){ .agents{grid-template-columns:1fr;} }

  /* ---------- writing ---------- */
  .essays{ display:grid; grid-template-columns:repeat(2,1fr); gap:2px; background:var(--line); border:1px solid var(--line); }
  .essay{
    background:var(--ivory); padding:44px 40px; transition:background .35s ease;
  }
  .essay:hover{ background:var(--ivory-dim); }
  .essay .cat{ font-size:11.5px; letter-spacing:.16em; text-transform:uppercase; color:var(--teal-deep); font-weight:700; }
  .essay h3{ font-size:23px; margin:14px 0 12px; }
  .essay p{ color:var(--ink-soft); font-size:14.8px; margin-bottom:18px; }
  .essay .read{ font-size:13.5px; font-weight:700; color:var(--navy); display:inline-flex; align-items:center; gap:8px; }
  .essay .read .arrow{ transition:transform .3s ease; }
  .essay:hover .read .arrow{ transform:translateX(5px); }
  @media (max-width:800px){ .essays{grid-template-columns:1fr;} }

  .essays-more{ text-align:center; margin-top:48px; }

  /* ---------- course ---------- */
  .course-panel{
    background:var(--navy); color:var(--ivory);
    display:grid; grid-template-columns:1.1fr 0.9fr;
    border:1px solid rgba(212,160,23,0.25);
  }
  .course-copy{ padding:64px 56px; }
  .course-copy .eyebrow{ color:var(--gold-soft); }
  .course-copy .eyebrow::before{ background:var(--gold-soft); }
  .course-copy h2{ color:var(--ivory); font-size:clamp(28px,3.2vw,38px); margin-bottom:20px; }
  .course-copy p{ color:#B9C3D4; font-size:16px; margin-bottom:30px; max-width:460px; }
  .outcomes{ display:grid; gap:14px; margin-bottom:36px; }
  .outcomes li{ display:flex; align-items:flex-start; gap:14px; font-size:15px; color:#DCE3EC; }
  .outcomes .mk{
    width:22px; height:22px; border-radius:50%; border:1px solid var(--gold-soft); flex-shrink:0;
    display:flex; align-items:center; justify-content:center; margin-top:1px;
  }
  .outcomes .mk svg{ width:11px; height:11px; }

  .course-side{
    background:var(--navy-soft); padding:56px 44px; display:flex; flex-direction:column; justify-content:center;
    border-left:1px solid rgba(250,249,246,0.1);
  }
  .course-side .label{ font-size:12px; letter-spacing:.14em; text-transform:uppercase; color:#8C99AE; margin-bottom:10px; }
  .course-side .name{ font-family:var(--serif); font-size:25px; color:var(--ivory); margin-bottom:22px; }
  .course-side .founding{
    font-size:13.5px; color:#AEB9CB; border-top:1px solid rgba(250,249,246,0.12); padding-top:20px; margin-top:22px; line-height:1.65;
  }
  @media (max-width:900px){ .course-panel{grid-template-columns:1fr;} .course-copy, .course-side{padding:44px 30px;} }

  /* ---------- poetic statement ---------- */
  .statement{
    background:var(--navy);
    padding:160px 0;
    position:relative;
    overflow:hidden;
  }
  .statement::before{
    content:"";
    position:absolute; inset:0;
    background: radial-gradient(600px 400px at 50% 0%, rgba(14,165,164,0.14), transparent 70%);
  }
  .statement-inner{
    max-width:760px; margin:0 auto; padding:0 32px; text-align:center; position:relative;
  }
  .statement p{
    font-family:var(--serif); font-style:italic; color:var(--ivory);
    font-size:clamp(21px,2.6vw,30px); line-height:1.8; margin-bottom:26px;
  }
  .statement p.tight{ margin-bottom:10px; }
  .statement .gold{ color:var(--gold-soft); font-style:normal; }
  .statement-mark{ width:34px; height:2px; background:var(--gold); margin:0 auto 42px; }

  /* ---------- contact ---------- */
  .contact-grid{ display:grid; grid-template-columns:1fr 1fr; gap:70px; align-items:start; }
  .contact-links{ margin-top:36px; display:grid; gap:18px; }
  .contact-links a{
    display:flex; align-items:center; justify-content:space-between;
    padding:20px 0; border-bottom:1px solid var(--line);
    font-family:var(--serif); font-size:19px; color:var(--navy); font-weight:600;
    transition:padding-left .3s ease, color .3s ease;
  }
  .contact-links a:hover{ padding-left:10px; color:var(--teal-deep); }
  .contact-links a .sub{ font-family:var(--sans); font-size:12.5px; color:var(--ink-soft); font-weight:500; }

  .newsletter{
    background:var(--ivory-dim); border:1px solid var(--line); padding:44px 38px;
  }
  .newsletter h4{ font-size:20px; margin-bottom:10px; }
  .newsletter p{ color:var(--ink-soft); font-size:14.5px; margin-bottom:24px; }
  .newsletter form{ display:flex; gap:0; border-bottom:1.5px solid var(--navy); padding-bottom:10px; }
  .newsletter input{
    flex:1; border:none; background:transparent; font-family:var(--sans); font-size:15px; padding:8px 0; outline:none; color:var(--navy);
  }
  .newsletter button{
    background:none; border:none; color:var(--navy); font-weight:700; font-size:13.5px; letter-spacing:.05em; text-transform:uppercase; cursor:pointer;
    display:flex; align-items:center; gap:6px;
  }
  .newsletter button:hover{ color:var(--teal-deep); }
  .newsletter .thanks{ display:none; font-size:14px; color:var(--teal-deep); margin-top:14px; font-weight:600; }
  .newsletter .thanks.show{ display:block; }
  @media (max-width:900px){ .contact-grid{grid-template-columns:1fr; gap:44px;} }

  /* ---------- footer ---------- */
  footer{ background:var(--navy); color:#8C99AE; padding:70px 0 36px; }
  .footer-quote{
    font-family:var(--serif); font-style:italic; color:#DCE3EC; font-size:19px; line-height:1.7;
    max-width:520px; margin-bottom:50px;
  }
  .footer-bottom{
    display:flex; justify-content:space-between; align-items:center; padding-top:26px;
    border-top:1px solid rgba(250,249,246,0.1); font-size:13px; flex-wrap:wrap; gap:14px;
  }
  .footer-bottom .fnav{ display:flex; gap:24px; }
  .footer-bottom a:hover{ color:var(--gold-soft); }

  ::selection{ background:var(--gold-soft); color:var(--navy); }

/* ---------- resources / documents (CMS-managed) ---------- */
.resources-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:2px; background:var(--line); border:1px solid var(--line); }
.resource-card{ background:var(--ivory); padding:34px 36px; transition:background .3s ease; display:flex; flex-direction:column; }
.resource-card:hover{ background:var(--ivory-dim); }
.resource-card .rc-date{ font-size:11.5px; letter-spacing:.14em; text-transform:uppercase; color:var(--teal-deep); font-weight:700; margin-bottom:12px; }
.resource-card h3{ font-size:20px; margin-bottom:10px; }
.resource-card p{ color:var(--ink-soft); font-size:14.5px; margin-bottom:18px; flex:1; }
.resource-card a.dl{ font-size:13.5px; font-weight:700; color:var(--navy); display:inline-flex; align-items:center; gap:8px; }
.empty-note{ color:var(--ink-soft); font-size:14.5px; font-style:italic; padding:20px 0; }

/* ---------- essay detail page ---------- */
.essay-detail{ max-width:720px; margin:0 auto; padding:170px 32px 120px; }
.essay-detail .cat{ font-size:12px; letter-spacing:.16em; text-transform:uppercase; color:var(--teal-deep); font-weight:700; }
.essay-detail h1{ font-size:clamp(30px,4vw,46px); margin:16px 0 20px; }
.essay-detail .meta{ color:var(--ink-soft); font-size:14px; margin-bottom:40px; }
.essay-detail .body p{ color:var(--ink); font-size:17px; margin-bottom:22px; line-height:1.85; }
.essay-detail .back{ display:inline-flex; margin-top:40px; font-weight:700; font-size:14px; color:var(--navy); }
